{{define "title"}}{{.Anime.DisplayTitle}} Media{{end}}
{{define "scripts"}}{{end}}
{{define "page_container"}}
<div class="-mx-4 -my-6 md:-mx-6 lg:-mx-8">
  {{template "content" .}}
</div>
{{end}}

{{define "content"}}
{{$anime := .Anime}}
{{$active := .ActiveKind}}
{{$backdropActive := eq $active "backdrops"}}
{{$logoActive := eq $active "logos"}}

<div class="min-h-[calc(100dvh-3.5rem)] bg-background px-4 py-6 md:px-6 lg:px-8">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <a href="/anime/{{$anime.MalID}}" class="mb-2 inline-flex text-xs text-foreground-muted transition-colors hover:text-foreground">Back to anime</a>
        <h1 class="text-2xl font-medium text-foreground">{{$anime.DisplayTitle}} Media</h1>
        {{if .TMDBLabel}}<p class="mt-1 text-xs text-foreground-muted">{{.TMDBLabel}}</p>{{end}}
      </div>

      <div class="inline-flex w-fit bg-background-button p-1">
        <a href="/anime/{{$anime.MalID}}/media?kind=backdrops" class="px-4 py-2 text-sm transition-colors {{if $backdropActive}}bg-background text-foreground{{else}}text-foreground-muted hover:text-foreground{{end}}">Backdrops</a>
        <a href="/anime/{{$anime.MalID}}/media?kind=logos" class="px-4 py-2 text-sm transition-colors {{if $logoActive}}bg-background text-foreground{{else}}text-foreground-muted hover:text-foreground{{end}}">Logos</a>
      </div>
    </div>

    {{if .LoadError}}
      <div class="border border-border-light px-6 py-12 text-sm text-foreground-muted">{{.LoadError}}</div>
    {{else if $backdropActive}}
      {{template "anime_media_grid" dict "Items" .Backdrops "Kind" "backdrops" "AnimeID" $anime.MalID "SelectedPath" .SelectedBackdropPath}}
    {{else}}
      {{template "anime_media_grid" dict "Items" .Logos "Kind" "logos" "AnimeID" $anime.MalID "SelectedPath" .SelectedLogoPath}}
    {{end}}
  </div>
</div>
{{end}}

{{define "anime_media_grid"}}
{{if .Items}}
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
    {{range .Items}}
      {{$selected := eq .FilePath $.SelectedPath}}
      <form method="POST" action="/anime/{{$.AnimeID}}/media" class="contents">
        <input type="hidden" name="kind" value="{{$.Kind}}" />
        <input type="hidden" name="file_path" value="{{.FilePath}}" />
        <button type="submit" class="group block w-full bg-background-surface text-left shadow-card ring-1 transition focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent {{if $selected}}ring-accent{{else}}ring-black/10 hover:ring-foreground-muted/40{{end}}">
          {{if eq $.Kind "logos"}}
            <div class="flex aspect-video items-center justify-center bg-neutral-950 p-8">
              <img src="{{.URL}}" alt="" class="max-h-full max-w-full object-contain transition-transform duration-200 group-hover:scale-[1.02]" loading="lazy" />
            </div>
          {{else}}
            <div class="aspect-video overflow-hidden bg-background-surface">
              <img src="{{.URL}}" alt="" class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]" loading="lazy" />
            </div>
          {{end}}
          <div class="flex items-center justify-between px-3 py-2 text-xs text-foreground-muted">
            <span>{{.Width}}x{{.Height}}</span>
            {{if $selected}}<span class="text-accent">Selected</span>{{else if .Language}}<span>{{.Language}}</span>{{else}}<span>No language</span>{{end}}
          </div>
        </button>
      </form>
    {{end}}
  </div>
{{else}}
  <div class="border border-border-light px-6 py-12 text-sm text-foreground-muted">No {{.Kind}} found.</div>
{{end}}
{{end}}
