{{define "title"}}{{.Anime.DisplayTitle}}{{end}}
{{define "scripts"}}{{if .WatchlistIDs}}<script type="application/json" id="watchlist-ids-json">{{.WatchlistIDs}}</script>{{end}}{{end}}
{{define "content"}}
{{$anime := .Anime}}
{{$ageRating := ageRatingLabel $anime}}
{{$genres := namedEntityNames $anime.Genres 5}}
{{$studios := namedEntityNames $anime.Studios 4}}
{{$producers := namedEntityNames $anime.Producers 6}}
{{$demographics := namedEntityNames $anime.Demographics 4}}
{{$licensors := namedEntityNames $anime.Licensors 4}}
{{$themes := namedEntityNames $anime.Themes 5}}
{{$tags := namedEntityNames $anime.Tags 6}}
{{$score := animeScore $anime.Score}}
{{$scorePercent := animeScorePercent $anime.Score}}
{{$scoreCount := formatCompactNumber $anime.ScoredBy}}
{{$posterImage := posterURL $anime.Images.Webp.LargeImageURL $anime.Images.Jpg.LargeImageURL 400 600}}
{{if or $anime.BannerImageURL $posterImage}}
  <div class="relative -mx-4 -mt-6 h-[900px] max-[1920px]:h-[700px] overflow-hidden before:pointer-events-none before:absolute before:inset-0 before:z-1 before:bg-[radial-gradient(ellipse_at_top_right,rgba(0,0,0,0.16)_0%,rgba(0,0,0,0.08)_28%,transparent_58%),radial-gradient(ellipse_at_top_left,rgba(0,0,0,0.08)_0%,transparent_45%)] after:pointer-events-none after:absolute after:inset-0 after:z-1 after:bg-[linear-gradient(to_top,rgba(0,0,0,0.68)_0%,rgba(0,0,0,0.42)_24%,rgba(0,0,0,0.12)_52%,transparent_72%),radial-gradient(ellipse_at_bottom_left,rgba(0,0,0,0.3)_0%,rgba(0,0,0,0.12)_32%,transparent_62%),radial-gradient(ellipse_at_bottom_right,rgba(0,0,0,0.28)_0%,rgba(0,0,0,0.1)_34%,transparent_64%),linear-gradient(to_right,rgba(0,0,0,0.42)_0%,rgba(0,0,0,0.2)_18%,transparent_38%,transparent_70%,rgba(0,0,0,0.32)_100%)] md:-mx-6 lg:-mx-8">
    {{if $anime.BannerImageURL}}
      <img src="{{$anime.BannerImageURL}}" alt="{{$anime.DisplayTitle}}" class="absolute size-full object-cover object-[center_42%]" />
    {{else}}
      <img src="{{$posterImage}}" alt="{{$anime.DisplayTitle}}" class="absolute -inset-8 h-[calc(100%+4rem)] w-[calc(100%+4rem)] scale-110 object-cover blur-3xl" />
    {{end}}
    <div class="absolute inset-x-6 bottom-12 z-5 flex max-w-2xl flex-col items-start gap-5 text-white md:left-12 md:right-auto lg:left-20">
      {{if $anime.LogoImageURL}}
        <img src="{{$anime.LogoImageURL}}" alt="{{$anime.DisplayTitle}}" class="max-h-60 max-w-[min(680px,86vw)] object-contain object-left drop-shadow-[0_12px_18px_rgba(0,0,0,0.65)]" />
      {{else}}
        <h1 class="max-w-xl text-5xl font-bold leading-none text-white drop-shadow-[0_8px_14px_rgba(0,0,0,0.7)]">{{$anime.DisplayTitle}}</h1>
      {{end}}

      <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm font-medium text-white/90">
        <span class="border border-white/70 px-1.5 py-0.5 text-xs font-bold leading-none text-white">{{if $ageRating}}{{$ageRating}}{{else}}14+{{end}}</span>
        {{if $anime.Type}}<span>{{$anime.Type}}</span>{{end}}
        {{if and $anime.Type $genres}}<span class="text-white/60">•</span>{{end}}
        {{if $genres}}<span>{{$genres}}</span>{{end}}
      </div>

      {{if $score}}
        <div class="flex flex-wrap items-center gap-3 text-sm font-semibold text-white">
          <span class="relative inline-block text-white/30" aria-hidden="true">
            <span class="flex w-max gap-0.5">
              {{range seq 5}}
                <svg class="size-6 fill-current" viewBox="0 0 24 24" focusable="false">
                  <path d="M12 2.4l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.4z" />
                </svg>
              {{end}}
            </span>
            <span class="absolute inset-y-0 left-0 overflow-hidden text-white/90" style="width: {{$scorePercent}}%">
              <span class="flex w-max gap-0.5">
                {{range seq 5}}
                  <svg class="size-6 fill-current" viewBox="0 0 24 24" focusable="false">
                    <path d="M12 2.4l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.4z" />
                  </svg>
                {{end}}
              </span>
            </span>
          </span>
          <span class="h-6 w-px bg-white/25" aria-hidden="true"></span>
          <span>Average Score: <strong>{{$score}}/10{{if $scoreCount}} ({{$scoreCount}}){{end}}</strong></span>
        </div>
      {{end}}

      <div class="flex flex-wrap items-center gap-3">
        <a href="/anime/{{$anime.MalID}}/watch{{if gt $.ContinueWatchingEp 0}}?ep={{$.ContinueWatchingEp}}{{end}}" class="inline-flex h-12 items-center gap-2 bg-white px-5 text-sm font-bold uppercase text-black transition-colors hover:bg-white/85 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white">
          <svg class="size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 3.8v16.4L19.2 12 6 3.8zm2 3.6l7.4 4.6L8 16.6V7.4z" />
          </svg>
          {{if gt $.ContinueWatchingEp 0}}Continue Watching{{else}}Start Watching E1{{end}}
        </a>
        <button type="button" data-watchlist-toggle data-mal-id="{{$anime.MalID}}" data-watchlist-title="{{$anime.DisplayTitle}}" data-watchlist-state="{{if $.WatchlistIDs}}in{{else}}out{{end}}" class="group inline-flex size-12 items-center justify-center border border-white text-white transition-colors hover:bg-white hover:text-black focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white disabled:opacity-50 data-[watchlist-state=in]:bg-white data-[watchlist-state=in]:text-black" aria-label="{{if $.WatchlistIDs}}Remove from Watchlist{{else}}Add to Watchlist{{end}}">
          <svg class="size-7 fill-none group-data-[watchlist-state=in]:fill-current [&_path]:fill-none group-data-[watchlist-state=in]:[&_path]:fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" />
          </svg>
        </button>
      </div>
    </div>
    <ui-dropdown class="absolute right-8 top-4 z-10 block md:right-10 lg:right-14" data-align="right" data-width="w-42">
      <div data-trigger class="cursor-pointer">
        <button type="button" class="ml-auto inline-flex h-10 items-center gap-3 bg-transparent px-3 text-sm font-semibold uppercase text-white transition-colors hover:bg-neutral-900 focus-visible:bg-neutral-900 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/80 aria-expanded:bg-neutral-900">
          <svg class="h-5 w-1 text-white" viewBox="0 0 4 20" fill="currentColor" aria-hidden="true">
            <circle cx="2" cy="4" r="1.5" />
            <circle cx="2" cy="10" r="1.5" />
            <circle cx="2" cy="16" r="1.5" />
          </svg>
          <span>MORE</span>
        </button>
      </div>
      <div data-content class="absolute right-0 top-10 z-50 hidden w-42 bg-neutral-900 shadow-card">
        <div class="flex flex-col py-3">
          <a href="/anime/{{$.Anime.MalID}}/media" class="flex w-full items-center px-4 py-1.5 text-left text-xs font-normal text-neutral-400 transition-colors hover:bg-neutral-800 hover:text-neutral-200 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/70">
            View Media Options
          </a>
        </div>
      </div>
    </ui-dropdown>
  </div>
{{end}}
{{if $anime.Synopsis}}
  <section class="-mx-4 bg-background px-6 py-8 md:-mx-6 md:px-12 lg:-mx-8 lg:px-20">
    <div data-synopsis-container data-synopsis-mode="fade" class="relative grid max-h-24 gap-10 overflow-hidden after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-10 after:bg-[linear-gradient(to_bottom,transparent,theme(colors.background))] md:grid-cols-[minmax(0,1fr)_minmax(20rem,0.9fr)]">
      <div class="max-w-2xl space-y-4 text-base leading-relaxed text-neutral-300">
        {{range synopsisParagraphs $anime.Synopsis}}
          <p>{{.}}</p>
        {{end}}
      </div>
      <dl class="space-y-2 text-sm leading-relaxed text-neutral-500">
        {{if or $anime.Type $anime.Episodes $anime.Duration}}<div><dt class="inline text-neutral-300">Format:</dt> <dd class="inline">{{if $anime.Type}}{{$anime.Type}}{{end}}{{if $anime.Episodes}}{{if $anime.Type}} series with {{end}}{{$anime.Episodes}} episodes{{end}}{{if $anime.Duration}}{{if or $anime.Type $anime.Episodes}}, {{end}}{{$anime.Duration}} per episode{{end}}</dd></div>{{end}}
        {{if or $anime.Status $anime.Season $anime.Year $anime.Aired.String $anime.Broadcast.String}}<div><dt class="inline text-neutral-300">Release:</dt> <dd class="inline">{{if $anime.Status}}{{$anime.Status}}{{end}}{{if or $anime.Season $anime.Year}}{{if $anime.Status}}, {{end}}{{if $anime.Season}}{{capitalize $anime.Season}}{{end}}{{if and $anime.Season $anime.Year}} {{end}}{{if $anime.Year}}{{$anime.Year}}{{end}}{{end}}{{if $anime.Aired.String}}{{if or $anime.Status $anime.Season $anime.Year}}, aired {{$anime.Aired.String}}{{end}}{{end}}{{if $anime.Broadcast.String}}, broadcast {{$anime.Broadcast.String}}{{end}}</dd></div>{{end}}
        {{if or $studios $producers $anime.Source}}<div><dt class="inline text-neutral-300">Production:</dt> <dd class="inline">{{if $studios}}Animated by {{$studios}}{{end}}{{if $producers}}{{if $studios}}, produced by {{else}}Produced by {{end}}{{$producers}}{{end}}{{if $anime.Source}}{{if or $studios $producers}}, adapted from {{else}}Adapted from {{end}}{{$anime.Source}}{{end}}</dd></div>{{end}}
        {{if or $ageRating $genres $demographics}}<div><dt class="inline text-neutral-300">Content:</dt> <dd class="inline">{{if $ageRating}}Rated <span class="inline-flex border border-white/20 px-1 py-0.5 text-xs font-bold leading-none text-neutral-300">{{$ageRating}}</span>{{end}}{{if $genres}}{{if $ageRating}} with {{end}}{{$genres}}{{end}}{{if $demographics}}{{if or $ageRating $genres}}, aimed at {{$demographics}}{{end}}{{end}}</dd></div>{{end}}
        {{if or $themes $tags}}<div><dt class="inline text-neutral-300">Themes:</dt> <dd class="inline">{{if $themes}}{{$themes}}{{end}}{{if and $themes $tags}} with tags like {{end}}{{if and (not $themes) $tags}}Tags include {{end}}{{if $tags}}{{$tags}}{{end}}</dd></div>{{end}}
        {{if or $score $anime.RankLabel $anime.Rank $anime.Popularity $anime.Members $anime.Favorites}}<div><dt class="inline text-neutral-300">Reception:</dt> <dd class="inline">{{if $score}}Average score {{$score}}{{if $scoreCount}} from {{$scoreCount}} ratings{{end}}{{end}}{{if $anime.RankLabel}}{{if $score}}, {{end}}{{$anime.RankLabel}}{{else if $anime.Rank}}{{if $score}}, ranked #{{$anime.Rank}}{{end}}{{end}}{{if $anime.Popularity}}, popularity #{{$anime.Popularity}}{{end}}{{if $anime.Members}}, {{formatNumber $anime.Members}} members{{end}}{{if $anime.Favorites}}, {{formatNumber $anime.Favorites}} favorites{{end}}</dd></div>{{end}}
      </dl>
    </div>
    <button type="button" data-synopsis-toggle class="mt-5 inline-flex text-xs font-bold uppercase text-accent transition-colors hover:text-accent/80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent">
      More Details
    </button>
    <div class="mt-3 h-px w-full bg-white/15"></div>
  </section>
{{end}}
{{template "anime_episode_list_loading" dict "AnimeID" $anime.MalID}}
{{template "anime_franchise_loading" dict "AnimeID" $anime.MalID}}
{{end}}
