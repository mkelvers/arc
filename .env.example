TMDB_READ_ACCESS_TOKEN=
DATABASE_URL=postgresql://arc:arc@localhost:5433/arc

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Cloudflare Turnstile server-side widget secret.
TURNSTILE_SECRET=
# Independent random secret used to sign Arc's seven-day human-clearance cookie.
TURNSTILE_CLEARANCE_SECRET=

# Ordered, comma-separated fallback chain.
PLAYBACK_PROVIDERS=allanime,anikoto,anineko,senshi

# Random bearer token used by the once-per-minute maintenance request and by an
# external uptime monitor checking /api/internal/maintenance/health.
ARC_MAINTENANCE_TOKEN=

ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:5173/settings/accounts/callback
