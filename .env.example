DATABASE_URL=postgresql://arc:arc@localhost:5433/arc

TMDB_READ_ACCESS_TOKEN=

# Ordered, comma-separated fallback chain.
PLAYBACK_PROVIDERS=allanime,anidb,senshi,anipub,anineko,animepahe

# Optional managed-challenge sessions. Arc falls through to the next
# provider when either site rejects ordinary server requests.
ANIDB_COOKIE=
ANIMEPAHE_COOKIE=

# Bearer token for POST /api/internal/episodes/refresh
EPISODE_SYNC_TOKEN=
