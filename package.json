{
    "name": "arc-workspace",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "preview": "turbo run preview",
        "check": "turbo run check",
        "lint": "oxlint",
        "test": "turbo run test",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "openapi:check": "bun --cwd apps/api openapi:check",
        "db:check": "bun --cwd packages/db db:check"
    },
    "devDependencies": {
        "@oxlint/plugins": "1.79.0",
        "oxfmt": "^0.64.0",
        "oxlint": "1.79.0",
        "turbo": "^2.10.11"
    },
    "overrides": {
        "@esbuild-kit/core-utils>esbuild": "^0.25.12",
        "@sveltejs/kit>cookie": "^0.7.0",
        "js-yaml": "^4.3.1"
    },
    "packageManager": "bun@1.4.0",
    "catalog": {
        "@types/node": "^26.2.0",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.9"
    }
}
