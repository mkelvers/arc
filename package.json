{
	"name": "arc",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"graphql:generate": "graphql-codegen --config codegen.ts",
		"openapi:generate": "openapi-typescript https://developer.themoviedb.org/openapi/tmdb-api.json -o src/lib/server/anime/tmdb/generated.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"db:up": "docker compose up -d --wait postgres",
		"db:down": "docker compose down",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^7.2.0",
		"@graphql-codegen/client-preset": "^6.1.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"graphql": "^16",
		"openapi-typescript": "^7.13.0",
		"phosphor-svelte": "^3.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"drizzle-orm": "^0.45.2",
		"effect": "^3.22.0",
		"openapi-fetch": "^0.17.0",
		"postgres": "^3.4.9"
	}
}
