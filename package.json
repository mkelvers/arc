{
    "name": "arc-workspace",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "preview": "turbo run preview",
        "check": "turbo run check",
        "lint": "oxlint",
        "test": "turbo run test",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "turbo": "^2.5.6"
    },
    "packageManager": "bun@1.3.14"
}
