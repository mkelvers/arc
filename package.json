{
    "name": "arc",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "dev:worker": "bun worker/src/index.ts",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "graphql:generate": "graphql-codegen --config codegen.ts",
        "openapi:generate": "openapi-typescript https://developer.themoviedb.org/openapi/tmdb-api.json -o src/lib/server/anime/tmdb/generated.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:check": "drizzle-kit check",
        "db:studio": "drizzle-kit studio",
        "db:up": "docker compose up -d --wait postgres",
        "db:down": "docker compose down",
        "test": "bun test",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "better-auth": "1.6.26",
        "bullmq": "^5.58.5",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "hls.js": "^1.6.17",
        "ioredis": "^5.6.1",
        "openapi-fetch": "^0.17.0",
        "postgres": "^3.4.9",
        "svelte-turnstile": "^0.11.0",
        "sveltekit-superforms": "^2.30.2",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.2.0",
        "@graphql-codegen/client-preset": "^6.1.2",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.2.0",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "graphql": "^17.0.2",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "phosphor-svelte": "^3.1.0",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.5",
        "tailwindcss": "^4.3.3",
        "typescript": "~6",
        "vite": "^8.2.1"
    }
}
