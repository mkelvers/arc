{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node"],
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["static/**/*.ts", "scripts/**/*.ts"]
}
