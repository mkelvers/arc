{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "allowJs": false,
    "noEmit": true,
    "types": ["node"],
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["static/**/*.ts", "scripts/**/*.ts"]
}
