{
    "name": "arc",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "graphql:generate": "graphql-codegen --config codegen.ts",
        "test": "bun test",
        "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "dependencies": {
        "@arc/api-contract": "workspace:*",
        "@arc/shared": "workspace:*",
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "better-auth": "1.6.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "hls.js": "^1.7.1",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.2.0",
        "@graphql-codegen/client-preset": "^6.1.3",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.0",
        "@types/node": "catalog:",
        "@typescript/native": "npm:typescript@~7.0.2",
        "dotenv": "catalog:",
        "graphql": "^17.0.2",
        "phosphor-svelte": "^3.1.0",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.2.2"
    }
}
