{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "denyWarnings": true
  },
  "ignorePatterns": [
    ".svelte-kit/**",
    "build/**",
    "dist/**",
    "drizzle/**",
    "node_modules/**",
    "**/generated/**",
    "**/generated.ts"
  ],
  "rules": {
    "complexity": ["error", 10],
    "import/max-dependencies": ["error", { "max": 12, "ignoreTypeImports": true }],
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "max-params": ["error", 4],
    "max-statements": ["error", 30]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "complexity": "off",
        "import/max-dependencies": "off",
        "max-depth": "off",
        "max-nested-callbacks": "off",
        "max-params": "off",
        "max-statements": "off"
      }
    }
  ]
}
