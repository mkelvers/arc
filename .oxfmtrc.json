{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "proseWrap": "never",
    "htmlWhitespaceSensitivity": "ignore",
    "ignorePatterns": [
        ".svelte-kit/**",
        "build/**",
        "drizzle/**",
        "node_modules/**",
        "**/generated/**",
        "**/generated.ts"
    ],
    "objectWrap": "preserve",
    "singleAttributePerLine": false,
    "overrides": [
        {
            "files": ["*.svelte"],
            "options": {
                "printWidth": 115
            }
        }
    ],
    "vueIndentScriptAndStyle": false,
    "svelte": {
        "allowShorthand": false
    }
}
